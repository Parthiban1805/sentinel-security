{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sentinel/asset.schema.json#v1",
  "title": "Sentinel asset inventory record",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "asset_type", "name", "owner", "importance", "monitoring", "last_seen"],
  "properties": {
    "asset_id": { "type": "string" },
    "asset_type": {
      "type": "string",
      "enum": ["developer_machine", "github_identity", "github_token", "repository", "api_key", "service_account",
               "ci_workflow", "ai_agent", "mcp_server", "server", "cloud_account", "database", "backup", "dependency", "artifact"]
    },
    "name": { "type": "string" },
    "owner": { "type": ["string", "null"], "description": "null = unowned = finding" },
    "importance": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "monitoring": { "type": "string", "enum": ["none", "partial", "full"] },
    "recovery_method": { "type": ["string", "null"] },
    "approved": { "type": "boolean", "default": false },
    "last_seen": { "type": "string", "format": "date-time" },
    "access_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_asset_id", "permission", "origin"],
        "properties": {
          "target_asset_id": { "type": "string" },
          "permission": { "type": "string" },
          "origin": { "type": "string", "enum": ["documented", "observed"] },
          "last_seen": { "type": "string", "format": "date-time" }
        }
      }
    },
    "attributes": { "type": "object" }
  }
}
